# Puerto en el que escucha el servidor Express
PORT=8080

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Cadena de conexion a MongoDB
MONGO_URL=mongodb://localhost:27017/eventos_peru

# Clave secreta para la firma de tokens JWT
JWT_SECRET=cambia_esta_clave_por_una_segura

# Tiempo de validez del token (formato de la libreria jsonwebtoken)
JWT_EXPIRES_IN=1h

# --- Email (Nodemailer) ---
# Credenciales para enviar el email de confirmacion al inscribirse a un evento.
# Con Gmail: activar verificacion en dos pasos y generar una "contraseña de aplicacion"
# (no la contraseña normal de la cuenta) para MAIL_PASS.
# Si se dejan vacias, el servidor arranca igual y solo se omite el envio (se avisa por log).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contraseña_de_aplicacion
MAIL_FROM=EventosPeru <tu_correo@gmail.com>

# --- Providers externos (OAuth) ---
# El sistema de autenticacion esta preparado para sumar estrategias de Passport
# para providers externos (Google, GitHub, etc.) sin tocar app.js. Estas variables
# no se usan todavia: quedan listas para cuando se agregue esa estrategia.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=
