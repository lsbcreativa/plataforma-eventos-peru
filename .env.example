# Puerto en el que escucha el servidor Express
PORT=8080

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Cadena de conexion a MongoDB
MONGO_URL=mongodb://localhost:27017/eventos_peru

# Clave secreta para la firma de tokens JWT
JWT_SECRET=cambia_esta_clave_por_una_segura

# Tiempo de validez del token (formato de la libreria jsonwebtoken)
JWT_EXPIRES_IN=1h
